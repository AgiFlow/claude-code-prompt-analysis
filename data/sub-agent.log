} else if (model === 'claude-sonnet-4-5-20250929') {\\n   129\u2192              stats.sonnetRequests++;\\n   130\u2192              stats.sonnetTokens.input += inputTokens;\\n   131\u2192              stats.sonnetTokens.output += outputTokens;\\n   132\u2192              stats.sonnetTokens.cacheCreation += cacheCreationTokens;\\n   133\u2192              stats.sonnetTokens.cacheRead += cacheReadTokens;\\n   134\u2192            }\\n   135\u2192          }\\n   136\u2192        } catch (parseError) {\\n   137\u2192          // Skip records with parsing issues\\n   138\u2192        }\\n   139\u2192      }\\n   140\u2192\\n   141\u2192    } catch (err) {\\n   142\u2192      console.error(`Error processing line ${count}:`, err.message);\\n   143\u2192    }\\n   144\u2192  }\\n   145\u2192\\n   146\u2192  writeReport();\\n   147\u2192}\\n   148\u2192\\n   149\u2192function writeReport() {\\n   150\u2192  // Calculate costs using official pricing\\n   151\u2192  // Assuming cache_creation_input_tokens are 5m cache writes (most common in Claude Code)\\n   152\u2192  const haikuCost =\\n   153\u2192    (stats.haikuTokens.input / 1_000_000) * PRICING['claude-3-5-haiku-20241022'].input +\\n   154\u2192    (stats.haikuTokens.output / 1_000_000) * PRICING['claude-3-5-haiku-20241022'].output +\\n   155\u2192    (stats.haikuTokens.cacheCreation / 1_000_000) * PRICING['claude-3-5-haiku-20241022'].cacheWrite5m +\\n   156\u2192    (stats.haikuTokens.cacheRead / 1_000_000) * PRICING['claude-3-5-haiku-20241022'].cacheRead;\\n   157\u2192\\n   158\u2192  const sonnetCost =\\n   159\u2192    (stats.sonnetTokens.input / 1_000_000) * PRICING['claude-sonnet-4-5-20250929'].input +\\n   160\u2192    (stats.sonnetTokens.output / 1_000_000) * PRICING['claude-sonnet-4-5-20250929'].output +\\n   161\u2192    (stats.sonnetTokens.cacheCreation / 1_000_000) * PRICING['claude-sonnet-4-5-20250929'].cacheWrite5m +\\n   162\u2192    (stats.sonnetTokens.cacheRead / 1_000_000) * PRICING['claude-sonnet-4