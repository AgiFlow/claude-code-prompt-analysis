            "text": "Please analyze the web crawler implementation in crawler.js and provide expert architectural guidance.\n\nHere is the complete code:\n\n```javascript\n/**\n * Web Crawler - Extracts text content and images from a URL\n * Usage: node crawler.js <url>\n */\n\nimport * as cheerio from 'cheerio';\n\nclass WebCrawler {\n  constructor(url) {\n    this.url = url;\n    this.results = {\n      url: url,\n      title: '',\n      textContent: [],\n      images: [],\n      metadata: {},\n      timestamp: new Date().toISOString()\n    };\n  }\n\n  /**\n   * Fetch HTML content from the URL\n   */\n  async fetchPage() {\n    try {\n      const response = await fetch(this.url, {\n        headers: {\n          'User-Agent': 'Mozilla/5.0 (compatible; WebCrawler/1.0)'\n        }\n      });\n\n      if (!response.ok) {\n        throw new Error(`HTTP error! status: ${response.status}`);\n      }\n\n      const html = await response.text();\n      return html;\n    } catch (error) {\n      console.error(`Error fetching ${this.url}:`, error.message);\n      throw error;\n    }\n  }\n\n  /**\n   * Parse HTML and extract data\n   */\n  parseContent(html) {\n    const $ = cheerio.load(html);\n\n    // Extract title\n    this.results.title = $('title').text().trim();\n\n    // Extract metadata\n    this.results.metadata = {\n      description: $('meta[name=\"description\"]').attr('content') || '',\n      keywords: $('meta[name=\"keywords\"]').attr('content') || '',\n      author: $('meta[name=\"author\"]').attr('content') || ''\n    };\n\n    // Extract text content from main content areas\n    const textElements = [\n      'p', 'h1', 'h2', 'h3', 'h4', 'h5', 'h6',\n      'article', 'section', 'li', 'blockquote'\n    ];\n\n    textElements.forEach(selector => {\n      $(selector).each((i, elem) => {\n        const text = $(elem).text().trim();\n        if (text && text.length > 0) {\n          this.results.textContent.push({\n            type: selector,\n            content: text\n          });\n        }\n      });\n    });\n\n    // Extract images\n    $('img').each((i, elem) => {\n      const $img = $(elem);\n      const src = $img.attr('src');\n\n      if (src) {\n        // Convert relative URLs to absolute\n        const absoluteSrc = this.resolveUrl(src);\n\n        this.results.images.push({\n          src: absoluteSrc,\n          alt: $img.attr('alt') || '',\n          title: $img.attr('title') || '',\n          width: $img.attr('width') || '',\n          height: $img.attr('height') || ''\n        });\n      }\n    });\n  }\n\n  /**\n   * Resolve relative URLs to absolute URLs\n   */\n  resolveUrl(relativeUrl) {\n    try {\n      return new URL(relativeUrl, this.url).href;\n    } catch (error) {\n      return relativeUrl;\n    }\n  }\n\n  /**\n   * Main crawl function\n   */\n  async crawl() {\n    console.log(`\\n🕷️  Crawling: ${this.url}\\n`);\n\n    try {\n      const html = await this.fetchPage();\n      this.parseContent(html);\n\n      console.log(`✅ Crawl completed successfully!\\n`);\n      this.displayResults();\n\n      return this.results;\n    } catch (error) {\n      console.error(`❌ Crawl failed:`, error.message);\n      throw error;\n    }\n  }\n\n  /**\n   * Display crawl results\n   */\n  displayResults() {\n    console.log(`📄 Title: ${this.results.title}`);\n    console.log(`📝 Text Content Items: ${this.results.textContent.length}`);\n    console.log(`🖼️  Images Found: ${this.results.images.length}`);\n    console.log(`\\n--- METADATA ---`);\n    console.log(JSON.stringify(this.results.metadata, null, 2));\n\n    if (this.results.images.length > 0) {\n      console.log(`\\n--- IMAGES (First 5) ---`);\n      this.results.images.slice(0, 5).forEach((img, i) => {\n        console.log(`${i + 1}. ${img.src}`);\n        if (img.alt) console.log(`   Alt: ${img.alt}`);\n      });\n    }\n\n    if (this.results.textContent.length > 0) {\n      console.log(`\\n--- TEXT CONTENT (First 3) ---`);\n      this.results.textContent.slice(0, 3).forEach((item, i) => {\n        const preview = item.content.substring(0, 100);\n        console.log(`${i + 1}. [${item.type}] ${preview}${item.content.length > 100 ? '...' : ''}`);\n      });\n    }\n  }\n\n  /**\n   * Save results to JSON file\n   */\n  async saveToFile(filename = 'crawl-results.json') {\n    const fs = await import('fs/promises');\n    await fs.writeFile(filename, JSON.stringify(this.results, null, 2));\n    console.log(`\\n💾 Results saved to: ${filename}`);\n  }\n}\n\n// CLI Usage\nasync function main() {\n  const url = process.argv[2];\n\n  if (!url) {\n    console.error('Usage: node crawler.js <url>');\n    console.error('Example: node crawler.js https://example.com');\n    process.exit(1);\n  }\n\n  // Validate URL\n  try {\n    new URL(url);\n  } catch (error) {\n    console.error('❌ Invalid URL provided');\n    process.exit(1);\n  }\n\n  const crawler = new WebCrawler(url);\n\n  try {\n    await crawler.crawl();\n    await crawler.saveToFile();\n  } catch (error) {\n    console.error('Crawling failed:', error);\n    process.exit(1);\n  }\n}\n\n// Run if called directly\nif (import.meta.url === `file://${process.argv[1]}`) {\n  main();\n}\n\nexport default WebCrawler;\n```\n\nPlease provide a comprehensive architectural analysis covering:\n\n1. **Architecture Pattern Assessment**: What architectural patterns are used? Are they appropriate for a web crawler?\n\n2. **Design Strengths**: What aspects of the design are well-implemented?\n\n3. **Design Weaknesses**: What are the architectural limitations or problems?\n\n4. **Scalability Concerns**: How would this design handle:\n   - Crawling multiple pages\n   - Rate limiting\n   - Large-scale operations\n   - Concurrent requests\n\n5. **Separation of Concerns**: Evaluate how well responsibilities are separated\n\n6. **Error Handling & Resilience**: Assess the robustness of the implementation\n\n7. **Extensibility**: How easy would it be to add new features like:\n   - Link extraction and following\n   - Robots.txt compliance\n   - Different output formats\n   - Custom parsers\n\n8. **Recommended Improvements**: Provide specific architectural recommendations with trade-offs\n\nPlease be thorough and provide actionable insights that would help improve this crawler's architecture.",
