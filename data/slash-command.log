    "content": "### 4. Improvements\n\n**High Priority:**\n\n**1. Add content-type validation**\n```javascript\nasync fetchPage() {\n  try {\n    const response = await fetch(this.url, {\n      headers: {\n        'User-Agent': 'Mozilla/5.0 (compatible; WebCrawler/1.0)'\n      }\n    });\n\n    if (!response.ok) {\n      throw new Error(`HTTP error! status: ${response.status}`);\n    }\n\n    // Add content-type check\n    const contentType = response.headers.get('content-type');\n    if (!contentType || !contentType.includes('text/html')) {\n      throw new Error(`Invalid content type: ${contentType}. Expected text/html`);\n    }\n\n    const html = await response.text();\n    return html;\n  } catch (error) {\n    console.error(`Error fetching ${this.url}:`, error.message);\n    throw error;\n  }\n}\n```\n\n**2. Fix duplicate content extraction**\n```javascript\nparseContent(html) {\n  const $ = cheerio.load(html);\n  \n  // Extract title\n  this.results.title = $('title').text().trim();\n  \n  // Extract metadata (unchanged)\n  this.results.metadata = {\n    description: $('meta[name=\"description\"]').attr('content') || '',\n    keywords: $('meta[name=\"keywords\"]').attr('content') || '',\n    author: $('meta[name=\"author\"]').attr('content') || ''\n  };\n  \n  // Improved text extraction - avoid duplicates\n  const seen = new Set();\n  const textElements = [\n    'p', 'h1', 'h2', 'h3', 'h4', 'h5', 'h6',\n    'article', 'section', 'li', 'blockquote'\n  ];\n  \n  textElements.forEach(selector => {\n    $(selector).each((i, elem) => {\n      const $elem = $(elem);\n      // Only get direct text, not nested elements\n      const text = $elem.clone().children().remove().end().text().trim();\n      \n      if (text && text.length > 0 && !seen.has(text)) {\n        seen.add(text);\n        this.results.textContent.push({\n          type: selector,\n          content: text\n        });\n      }\n    });\n  });\n  \n  // Extract images (unchanged)\n  // ...\n}\n```\n\n**3. Add configuration options**\n```javascript\nclass WebCrawler {\n  constructor(url, options = {}) {\n    this.url = url;\n    this.options = {\n      timeout: options.timeout || 10000,\n      maxTextItems: options.maxTextItems || 1000,\n      maxImages: options.maxImages || 500,\n      respectRobots: options.respectRobots !== false,\n      userAgent: options.userAgent || 'Mozilla/5.0 (compatible; WebCrawler/1.0)'\n    };\n    this.results = {\n      url: url,\n      title: '',\n      textContent: [],\n      images: [],\n      metadata: {},\n      timestamp: new Date().toISOString()\n    };\n  }\n  \n  // Apply limits in parsing\n  parseContent(html) {\n    // ... existing code ...\n    \n    // Apply maxTextItems limit\n    if (this.results.textContent.length >= this.options.maxTextItems) {\n      console.warn(`⚠️  Reached max text items limit: ${this.options.maxTextItems}`);\n      return;\n    }\n  }\n}\n```\n\n**4. Better error handling for file operations**\n```javascript\nasync saveToFile(filename = 'crawl-results.json') {\n  try {\n    const fs = await import('fs/promises');\n    await fs.writeFile(filename, JSON.stringify(this.results, null, 2));\n    console.log(`\\n💾 Results saved to: ${filename}`);\n  } catch (error) {\n    console.error(`❌ Failed to save results: ${error.message}`);\n    throw error;\n  }\n}\n```\n\n**Medium Priority:**\n\n**5. Add link extraction**\n```javascript\n// Extract internal and external links\n$('a[href]').each((i, elem) => {\n  const href = $(elem).attr('href');\n  const absoluteHref = this.resolveUrl(href);\n  // Categorize as internal/external, store in results\n});\n```\n\n**6. Add structured data extraction**\n```javascript\n// Extract JSON-LD, Open Graph, Twitter Cards\nconst jsonLd = $('script[type=\"application/ld+json\"]').text();\nconst ogTags = {};\n$('meta[property^=\"og:\"]').each((i, elem) => {\n  const property = $(elem).attr('property');\n  ogTags[property] = $(elem).attr('content');\n});\n```\n\n**7. Add retry logic with exponential backoff**\n```javascript\nasync fetchPage(retries = 3) {\n  for (let i = 0; i < retries; i++) {\n    try {\n      // ... fetch logic ...\n      return html;\n    } catch (error) {\n      if (i === retries - 1) throw error;\n      const delay = Math.pow(2, i) * 1000;\n      await new Promise(resolve => setTimeout(resolve, delay));\n    }\n  }\n}\n```",
